{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{index.html,style.css,script.js,manifest.json,test_sample.jpg,checkpoints/**}"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index?route=health"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/index?route=diagnostics"
    },
    {
      "source": "/benchmarks",
      "destination": "/api/index?route=benchmarks"
    },
    {
      "source": "/models",
      "destination": "/api/index?route=models"
    },
    {
      "source": "/analyze",
      "destination": "/api/index?route=analyze"
    },
    {
      "source": "/analyze_batch",
      "destination": "/api/index?route=analyze_batch"
    },
    {
      "source": "/debug",
      "destination": "/api/index?route=debug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?route=$1"
    }
  ]
}
