{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{index.html,style.css,script.js,manifest.json,test_sample.jpg,checkpoints/**}"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/index"
    },
    {
      "source": "/benchmarks",
      "destination": "/api/index"
    },
    {
      "source": "/models",
      "destination": "/api/index"
    },
    {
      "source": "/analyze",
      "destination": "/api/index"
    },
    {
      "source": "/analyze_batch",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
